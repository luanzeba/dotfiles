#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common.sh"

supported_platform() {
    is_arch && command -v omarchy &>/dev/null
}

check_installed() {
    supported_platform && pacman -Q blender &>/dev/null
}

install() {
    if ! supported_platform; then
        echo "Blender installation is currently supported only on Omarchy; skipping."
        return 0
    fi

    omarchy pkg add blender
}

configure() {
    :
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
