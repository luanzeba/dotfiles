#!/bin/bash
set -e

# Shared CLI basics (fzf, fd, ffmpeg, jq, eza, ripgrep, ssh, tmux, pdftotext).

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/../lib/nix.sh"

nix_package_tool base fzf fd ffmpeg jq eza rg ssh-keygen tmux pdftotext uv

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
