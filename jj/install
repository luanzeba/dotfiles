#!/bin/bash
set -e

# jj (Jujutsu) - A Git-compatible VCS

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

nix_package_tool jj jj

check_configured() {
    [[ -L "$HOME/.config/jj/config.toml" ]]
}

configure() {
    mkdir -p "$HOME/.config/jj"
    ln -sf "$SCRIPT_DIR/config.toml" "$HOME/.config/jj/config.toml"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
