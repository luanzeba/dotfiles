#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

nix_package_tool git git

check_configured() {
    [[ -L "$HOME/.gitconfig" && -L "$HOME/.gitconfig-work" ]]
}

configure() {
    ln -sf "$SCRIPT_DIR/.gitconfig" ~/.gitconfig
    ln -sf "$SCRIPT_DIR/gitconfig-work" ~/.gitconfig-work
    ln -sf "$SCRIPT_DIR/.gitignore_global" ~/.gitignore_global
    ln -sfn "$SCRIPT_DIR/.git_template" ~/.git_template
    touch ~/.gitconfig-macos  # create empty file for include directive
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
