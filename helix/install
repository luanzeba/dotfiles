#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELIX_CONFIG_DIR="$HOME/.config/helix"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

nix_package_tool helix hx

check_configured() {
    [[ -L "$HELIX_CONFIG_DIR/config.toml" && -L "$HELIX_CONFIG_DIR/languages.toml" ]]
}

configure() {
    mkdir -p "$HELIX_CONFIG_DIR"
    ln -sf "$SCRIPT_DIR/config.toml" "$HELIX_CONFIG_DIR/config.toml"
    ln -sf "$SCRIPT_DIR/languages.toml" "$HELIX_CONFIG_DIR/languages.toml"

    # Nix's hx wrapper sets HELIX_RUNTIME itself. Older installs linked
    # runtime/ into a store path, which breaks after GC; remove that link.
    [[ ! -L "$HELIX_CONFIG_DIR/runtime" ]] || rm -f "$HELIX_CONFIG_DIR/runtime"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
