#!/bin/bash
set -e

# GitHub CLI (gh)
# https://github.com/cli/cli

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

nix_package_tool gh gh

JOBS="$SCRIPT_DIR/../jobs/jobs"

check_configured() {
    [[ -L "$HOME/.config/gh-not" ]]
}

configure() {
    if ! command -v gh &>/dev/null; then
        echo "gh not installed, skipping extension installation"
        return 0
    fi

    echo "Installing gh extensions..."

    gh extension install github/gh-shell 2>/dev/null || true
    gh extension install rneatherway/gh-slack 2>/dev/null || true
    gh extension install nobe4/gh-not 2>/dev/null || true

    mkdir -p "$HOME/.config"
    local gh_not_config="$HOME/.config/gh-not"
    if [[ -e "$gh_not_config" && ! -L "$gh_not_config" ]]; then
        mv "$gh_not_config" "$gh_not_config.backup.$(date +%Y%m%d%H%M%S)"
    fi
    ln -sfn "$SCRIPT_DIR/.config/gh-not" "$gh_not_config"

    # Sync notifications hourly (jobs/jobs.json)
    "$JOBS" enable gh-not-sync
}

# TODO: Remove after 2027-02-01, once every machine has pulled this.
# Migration: the gh-not-sync job replaces the luan.gh-not-sync.hourly LaunchAgent.
apply() {
    local plist="$HOME/Library/LaunchAgents/gh-not-sync.plist"
    [[ -L "$plist" ]] || return 0
    "$JOBS" enable gh-not-sync || return 1 # keep the old agent until the job is in place
    launchctl bootout "gui/$(id -u)/luan.gh-not-sync.hourly" 2>/dev/null || true
    rm -f "$plist"
}

update() {
    nix_sync gh

    if command -v gh &>/dev/null; then
        echo "Updating gh extensions..."
        gh extension upgrade --all 2>/dev/null || true
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
