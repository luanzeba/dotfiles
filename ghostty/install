#!/bin/bash
set -euo pipefail

# Ghostty configuration. On Linux, the package is installed separately; this
# script only manages its config when the binary is already available.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
GHOSTTY_CONFIG="$CONFIG_HOME/ghostty/config"

is_macos() {
    [[ "$(uname)" == "Darwin" ]]
}

supported_platform() {
    (is_macos && [[ -d "/Applications/Ghostty.app" ]]) || command -v ghostty &>/dev/null
}

check_installed() {
    supported_platform
}

check_configured() {
    supported_platform \
        && [[ -L "$GHOSTTY_CONFIG" ]] \
        && [[ "$(readlink -f "$GHOSTTY_CONFIG")" == "$SCRIPT_DIR/config" ]]
}

install() {
    if command -v ghostty &>/dev/null; then
        echo "Ghostty already installed"
        return 0
    fi

    if ! is_macos; then
        echo "Ghostty is not installed; skipping config"
        return 0
    fi

    if command -v brew &>/dev/null; then
        brew install --cask ghostty
    else
        echo "Please install Ghostty from https://ghostty.org"
        return 1
    fi
}

configure() {
    supported_platform || return 0

    mkdir -p "$(dirname "$GHOSTTY_CONFIG")"
    if [[ -e "$GHOSTTY_CONFIG" && ! -L "$GHOSTTY_CONFIG" ]]; then
        mv "$GHOSTTY_CONFIG" "$GHOSTTY_CONFIG.backup.$(date +%s)"
        echo "Backed up existing Ghostty config"
    fi

    ln -sfn "$SCRIPT_DIR/config" "$GHOSTTY_CONFIG"
    echo "Linked $GHOSTTY_CONFIG"
}

apply() {
    : # Ghostty watches its config file.
}

update() {
    if is_macos && command -v brew &>/dev/null; then
        brew upgrade --cask ghostty 2>/dev/null || true
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
