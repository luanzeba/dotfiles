#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

check_installed() {
    nix_profile_has_entry "$NIX_NODE_PROFILE_NAME"
}

check_configured() {
    bootstrap_node_tooling_path || return 1
    command -v node &>/dev/null \
        && command -v npm &>/dev/null \
        && command -v corepack &>/dev/null \
        && [[ -L "$HOME/.local/bin/pnpm" && -x "$HOME/.local/bin/pnpm" ]] \
        && [[ -L "$HOME/.local/bin/pnpx" && -x "$HOME/.local/bin/pnpx" ]] \
        && command -v tsc &>/dev/null \
        && command -v typescript-language-server &>/dev/null \
        && command -v prettier &>/dev/null \
        && command -v tree-sitter &>/dev/null
}

install() {
    nix_profile_sync_node
}

configure() {
    bootstrap_node_tooling_path || return 1
    mkdir -p "$HOME/.local/bin"
    corepack enable --install-directory "$HOME/.local/bin" pnpm
}

apply() {
    check_installed || return 0
    configure
}

update() {
    nix_profile_sync_node
    configure
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
