#!/bin/bash
set -e

# Latest Node.js + TypeScript tooling; pnpm via Corepack.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

nix_package_tool node node npm corepack tsc typescript-language-server prettier tree-sitter

check_configured() {
    [[ -x "$HOME/.local/bin/pnpm" && -x "$HOME/.local/bin/pnpx" ]]
}

configure() {
    mkdir -p "$HOME/.local/bin"
    # Nix's node prefix is read-only; send interactive `npm i -g` to ~/.local too.
    npm config set prefix "$NPM_CONFIG_PREFIX"
    corepack enable --install-directory "$HOME/.local/bin" pnpm
}

apply() {
    check_installed || return 0
    configure
}

update() {
    nix_installed node || return 0
    nix_sync node
    configure
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
