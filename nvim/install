#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/nix.sh"

nix_package_tool nvim nvim

check_configured() {
    [[ -L "$HOME/.config/nvim" ]]
}

configure() {
    mkdir -p "$HOME/.config"
    # Leave a real (non-symlink) config dir alone, e.g. Omarchy's.
    if [[ ! -e "$HOME/.config/nvim" || -L "$HOME/.config/nvim" ]]; then
        ln -sfn "$SCRIPT_DIR" "$HOME/.config/nvim"
    fi

    nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
    nvim --headless "+MasonInstall ruby-lsp" +qa 2>/dev/null || true
}

apply() {
    command -v nvim &>/dev/null || return 0
    nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
}

update() {
    nix_sync nvim
    nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
    nvim --headless "+MasonUpdate" +qa 2>/dev/null || true
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
