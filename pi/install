#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PI_CONFIG_DIR="$HOME/.pi/agent"
# Use a user-writable npm prefix. npm may resolve to either repo-vendored
# Node or Nix Node, whose default global prefixes are not stable/writable.
PI_NPM_PREFIX="$HOME/.local"
PI_NPM_PACKAGE="@earendil-works/pi-coding-agent"
PI_BIN="$PI_NPM_PREFIX/bin/pi"

# shellcheck disable=SC1091
source "$DOTFILES_DIR/lib/common.sh"

check_installed() {
    bootstrap_node_tooling_path >/dev/null 2>&1 || true
    [[ -x "$PI_BIN" ]]
}

check_configured() {
    [[ -L "$PI_CONFIG_DIR/AGENTS.md" ]]
}

# Link every *.ts file and every directory containing index.ts. pi discovers both
# shapes; directories are used when an extension spans several modules.
link_extensions() {
    local source_dir="$1" target_dir="$2"
    mkdir -p "$target_dir"

    # Drop symlinks we created earlier whose source no longer exists.
    for linked in "$target_dir"/*; do
        [[ -L "$linked" ]] || continue
        local target
        target="$(readlink "$linked")"
        if [[ "$target" == "$source_dir/"* && ! -e "$target" ]]; then
            rm -f "$linked"
            echo "Removed stale extension: $linked"
        fi
    done

    for ext in "$source_dir"/*; do
        local name
        name="$(basename "$ext")"
        if [[ -f "$ext" && "$name" == *.ts ]]; then
            :
        elif [[ -d "$ext" && -f "$ext/index.ts" ]]; then
            :
        else
            continue
        fi
        rm -rf "$target_dir/$name"
        ln -s "$ext" "$target_dir/$name"
        echo "Linked extension: $target_dir/$name"
    done
}

pi_package_installed() {
    npm ls -g --depth=0 "$PI_NPM_PACKAGE" >/dev/null 2>&1
}

# Install pi coding agent via npm
install() {
    # Ensure npm is available.
    if ! ensure_npm; then
        echo "npm not found. Please install Node.js first (node/install)"
        return 1
    fi

    setup_npm_global_prefix "$PI_NPM_PREFIX"

    if pi_package_installed && [[ -x "$PI_BIN" ]]; then
        echo "pi already installed"
        return 0
    fi

    echo "Installing pi coding agent ($PI_NPM_PACKAGE)..."
    # --force handles migration from the deprecated @mariozechner scope,
    # which owns the same `pi` binary path.
    npm install -g --force "$PI_NPM_PACKAGE"
}

# Symlink pi configuration
configure() {
    mkdir -p "$PI_CONFIG_DIR"

    # Symlink AGENTS.md
    if [[ -f "$SCRIPT_DIR/AGENTS.md" ]]; then
        rm -f "$PI_CONFIG_DIR/AGENTS.md"
        ln -s "$SCRIPT_DIR/AGENTS.md" "$PI_CONFIG_DIR/AGENTS.md"
        echo "Linked: $PI_CONFIG_DIR/AGENTS.md"
    fi

    # Create skills directory (will be populated by skills/install)
    mkdir -p "$PI_CONFIG_DIR/skills"

    # Symlink extensions
    if [[ -d "$SCRIPT_DIR/extensions" ]]; then
        link_extensions "$SCRIPT_DIR/extensions" "$PI_CONFIG_DIR/extensions"
    fi

    # Remove the old review-only agent links; the prompts now live beside the extension.
    for name in reviewer.md simplifier.md correctness-reviewer.md; do
        local linked="$PI_CONFIG_DIR/agents/$name"
        if [[ -L "$linked" && "$(readlink "$linked")" == "$SCRIPT_DIR/agents/$name" ]]; then
            rm "$linked"
        fi
    done
    rmdir "$PI_CONFIG_DIR/agents" 2>/dev/null || true
}

update() {
    if ! ensure_npm; then
        echo "npm not found, cannot update pi"
        return 1
    fi

    setup_npm_global_prefix "$PI_NPM_PREFIX"

    echo "Updating pi coding agent ($PI_NPM_PACKAGE)..."
    npm update -g "$PI_NPM_PACKAGE"
}

# Main (only run when executed directly, not when sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
