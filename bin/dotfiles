#!/bin/bash
#
# dotfiles - CLI for managing dotfiles
#
# Usage:
#   dotfiles <command> [args]
#
# Commands:
#   status            Show install/config health of each tool
#   pull              Pull latest changes and apply them
#   edit              Open dotfiles in editor
#   install           Run main install script
#   install <tools>   Install specific tool(s)
#   update [tools]    Update all tools or specific tool(s)
#

set -e

# Verbose mode (set via -v or --verbose flag)
VERBOSE=false

# Load common utilities
# Resolve symlinks to find the real script location (portable across macOS/Linux)
REAL_SCRIPT="$0"
while [[ -L "$REAL_SCRIPT" ]]; do
    LINK_DIR="$(cd -P "$(dirname "$REAL_SCRIPT")" && pwd)"
    REAL_SCRIPT="$(readlink "$REAL_SCRIPT")"
    # Handle relative symlinks
    [[ "$REAL_SCRIPT" != /* ]] && REAL_SCRIPT="$LINK_DIR/$REAL_SCRIPT"
done
SCRIPT_DIR="$(cd -P "$(dirname "$REAL_SCRIPT")/.." && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

log_verbose() {
    if [[ "$VERBOSE" == true ]]; then
        echo "  $*"
    fi
}

# Every top-level directory with an `install` script is a tool.
get_available_tools() {
    local d
    for d in "$(dotfiles_dir)"/*/install; do
        [[ -f "$d" ]] && basename "$(dirname "$d")"
    done
}

# Run a function from a tool's install script in a subshell.
# Usage: tool_run <tool> <function> [args...]
tool_run() {
    local tool="$1"
    shift
    (
        set +e
        # shellcheck disable=SC1090
        source "$(dotfiles_dir)/$tool/install" >/dev/null || exit 1
        "$@"
    )
}

# Usage: tool_has <tool> <function>
tool_has() {
    tool_run "$1" declare -F "$2" &>/dev/null
}

# Print a health-check result: yes, no, or <fallback> if the hook is missing.
# Usage: tool_check <tool> <check_installed|check_configured> <fallback>
tool_check() {
    local tool="$1" check="$2" fallback="$3"
    tool_run "$tool" eval "
        if ! declare -F $check >/dev/null; then echo $fallback
        elif $check &>/dev/null; then echo yes
        else echo no; fi
    " 2>/dev/null
}

# Commands

cmd_status() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { show_status_help; return 0; }

    if [[ -n "${1:-}" ]]; then
        cmd_status_tool "$1"
        return $?
    fi

    echo "Dotfiles Status"
    echo "==============="
    echo ""
    echo "Location: $(dotfiles_dir)"
    echo ""

    echo -n "Platform: "
    if is_omarchy; then
        echo "Omarchy (Arch Linux)"
    elif is_macos; then
        echo "macOS"
    elif is_arch; then
        echo "Arch Linux"
    else
        echo "Unknown"
    fi
    echo ""

    local tools=() tool width=4
    mapfile -t tools < <(get_available_tools)
    for tool in "${tools[@]}"; do
        (( ${#tool} > width )) && width=${#tool}
    done

    local bar_tool bar_inst bar_conf
    bar_tool=$(printf '%*s' $((width + 2)) '' | sed 's/ /─/g')
    bar_inst=$(printf '%*s' 11 '' | sed 's/ /─/g')
    bar_conf=$(printf '%*s' 12 '' | sed 's/ /─/g')

    echo "┌${bar_tool}┬${bar_inst}┬${bar_conf}┐"
    printf "│ %-${width}s │ Installed │ Configured │\n" "Tool"
    echo "├${bar_tool}┼${bar_inst}┼${bar_conf}┤"

    local fully_configured=0 inst conf inst_display conf_display
    for tool in "${tools[@]}"; do
        read -r inst conf < <(tool_run "$tool" eval '
            if ! declare -F check_installed >/dev/null; then echo -n "unknown "
            elif check_installed &>/dev/null; then echo -n "yes "
            else echo -n "no "; fi
            if ! declare -F check_configured >/dev/null; then echo na
            elif check_configured &>/dev/null; then echo yes
            else echo no; fi
        ' 2>/dev/null)

        case "$inst" in
            yes) inst_display="${GREEN}[OK]${NC}" ;;
            no)  inst_display="${RED}[NO]${NC}" ;;
            *)   inst_display="${YELLOW}[??]${NC}" ;;
        esac
        case "$conf" in
            yes) conf_display="${GREEN}[OK]${NC}" ;;
            no)  conf_display="${RED}[NO]${NC}" ;;
            na)
                # No config needed: OK once installed.
                if [[ "$inst" == "yes" ]]; then
                    conf_display="${GREEN}[OK]${NC}"
                else
                    conf_display="${DIM}[--]${NC}"
                fi
                ;;
            *)   conf_display="${YELLOW}[??]${NC}" ;;
        esac

        if [[ "$inst" == "yes" && ("$conf" == "yes" || "$conf" == "na") ]]; then
            fully_configured=$((fully_configured + 1))
        fi

        printf "│ %-${width}s │   %b    │    %b    │\n" "$tool" "$inst_display" "$conf_display"
    done

    echo "└${bar_tool}┴${bar_inst}┴${bar_conf}┘"
    echo ""

    echo "$fully_configured/${#tools[@]} tools fully configured"
    if [[ $fully_configured -lt ${#tools[@]} ]]; then
        echo "Run 'dot install <tool>' to install/configure missing tools"
    fi

    local err_count
    err_count=$(error_count)
    if [[ "$err_count" -gt 0 ]]; then
        echo ""
        echo "Recent errors ($err_count total):"
        show_recent_errors 3
        echo ""
        echo "Run 'dot logs' for details"
    fi
}

# Show detailed status for a specific tool
cmd_status_tool() {
    local tool_name="$1"

    if [[ ! -f "$(dotfiles_dir)/$tool_name/install" ]]; then
        log_error "Unknown tool: $tool_name"
        echo ""
        echo "Available tools:"
        get_available_tools | sed 's/^/  /'
        return 1
    fi

    echo "Tool: $tool_name"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    local inst_status conf_status version_info=""
    inst_status=$(tool_check "$tool_name" check_installed unknown)
    conf_status=$(tool_check "$tool_name" check_configured na)

    if [[ "$inst_status" == "yes" ]]; then
        version_info=$(tool_run "$tool_name" eval 'declare -F get_installed_version >/dev/null && get_installed_version' 2>/dev/null) || true
        if [[ -z "$version_info" ]] && command -v "$tool_name" &>/dev/null; then
            version_info=$("$tool_name" --version 2>/dev/null | head -1) || true
        fi
    fi

    printf "Installed:  "
    case "$inst_status" in
        yes) printf "${GREEN}[OK]${NC}"; [[ -n "$version_info" ]] && printf " %s" "$version_info" ;;
        no)  printf "${RED}[NO]${NC} (not installed)" ;;
        *)   printf "${YELLOW}[??]${NC} (no check defined)" ;;
    esac
    echo ""

    printf "Configured: "
    case "$conf_status" in
        yes) printf "${GREEN}[OK]${NC}" ;;
        no)  printf "${RED}[NO]${NC} (not configured)" ;;
        na)  printf "${DIM}[--]${NC} (no config required)" ;;
        *)   printf "${YELLOW}[??]${NC}" ;;
    esac
    echo ""
    echo ""

    # Tool field may be "tool" or "tool/script".
    local pattern="\|${tool_name}(/|\|)"
    if [[ -f "$ERROR_LOG" ]] && grep -qE "$pattern" "$ERROR_LOG"; then
        echo "Recent errors ($(grep -cE "$pattern" "$ERROR_LOG") total):"
        grep -E "$pattern" "$ERROR_LOG" | tail -3 | while IFS='|' read -r ts cmd _tool _code short _full; do
            local date_part="${ts:0:16}"
            printf "  %-16s %-8s %s\n" "${date_part/T/ }" "$cmd" "$short"
        done
        echo ""
        echo "Run 'dot logs $tool_name' for full details"
    else
        echo "No recent errors"
    fi
}

cmd_edit() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { show_edit_help; return 0; }

    local editor="${EDITOR:-}"
    if [[ -z "$editor" ]]; then
        editor=$(command -v nvim || command -v vim) || {
            echo "No editor found. Set \$EDITOR or install nvim/vim."
            exit 1
        }
    fi
    $editor "$(dotfiles_dir)"
}

vcs_pull() {
    if [[ -d .jj ]] && command -v jj &>/dev/null; then
        jj git fetch && jj rebase -d main@origin || return 1
        if [[ -n "$(jj log -r 'conflicts() & ::@' --no-graph -T 'change_id ++ "\n"')" ]]; then
            log_error "Pull introduced unresolved jj conflicts; resolve them before applying changes."
            return 1
        fi
    else
        git pull --rebase --autostash
    fi
}

cmd_pull() {
    local force_apply=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) show_pull_help; return 0 ;;
            --apply) force_apply=true ;;
            *) log_error "Unknown option: $1"; show_pull_help; return 1 ;;
        esac
        shift
    done

    cd "$(dotfiles_dir)" || exit 1

    clear_error_log
    log_info "Pulling latest changes..."
    if ! run_logged "pull" "-" vcs_pull; then
        log_error "Pull failed"
        return 1
    fi

    if is_omarchy && [[ "$force_apply" != "true" ]]; then
        log_info "Omarchy detected: pulled latest changes."
        log_info "Skipping apply() to preserve Omarchy defaults."
        log_info "Run 'dot pull --apply' when you want to apply tool changes."
        log_success "Done!"
        return 0
    fi

    log_info "Applying changes..."
    apply_all

    log_success "Done!"
}

apply_all() {
    local tool
    for tool in $(get_available_tools); do
        if tool_has "$tool" apply; then
            log_info "Applying $tool..."
            run_logged "pull" "$tool" tool_run "$tool" apply || log_warn "Failed to apply $tool"
        else
            log_verbose "Skipping $tool (no apply function)"
        fi
    done
}

cmd_update() {
    local tools=() tool update_all=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) show_update_help; return 0 ;;
            -*) log_error "Unknown option: $1"; show_update_help; return 1 ;;
            *) tools+=("$1"); shift ;;
        esac
    done

    if [[ ${#tools[@]} -eq 0 ]]; then
        update_all=true
        mapfile -t tools < <(get_available_tools)
    else
        local unknown=()
        for tool in "${tools[@]}"; do
            [[ -f "$(dotfiles_dir)/$tool/install" ]] || unknown+=("$tool")
        done
        if [[ ${#unknown[@]} -gt 0 ]]; then
            log_error "Unknown tool(s): ${unknown[*]}"
            echo "Available tools:"
            get_available_tools | sed 's/^/  - /'
            return 1
        fi
    fi

    log_info "Updating tools..."
    local failed_tools=() unsupported_tools=()
    if [[ "$update_all" == true ]] && is_macos && command -v brew &>/dev/null; then
        log_info "Updating Homebrew..."
        run_logged "update" "homebrew" sh -c 'brew update && brew upgrade' || failed_tools+=("homebrew")
    fi

    for tool in "${tools[@]}"; do
        if tool_has "$tool" update; then
            log_info "Updating $tool..."
            if ! run_logged "update" "$tool" tool_run "$tool" update; then
                failed_tools+=("$tool")
                log_warn "Failed to update $tool"
            fi
        elif [[ "$update_all" == false ]]; then
            unsupported_tools+=("$tool")
            log_warn "$tool has no update() function"
        else
            log_verbose "Skipping $tool (no update function)"
        fi
    done

    [[ ${#unsupported_tools[@]} -eq 0 ]] || log_warn "No update function: ${unsupported_tools[*]}"
    if [[ ${#failed_tools[@]} -gt 0 ]]; then
        log_warn "Some tools failed to update: ${failed_tools[*]}"
        echo "Run 'dot logs' to see error details"
    fi
    [[ ${#failed_tools[@]} -eq 0 && ${#unsupported_tools[@]} -eq 0 ]] || return 1
    if [[ "$update_all" == true ]]; then
        log_success "All tools updated!"
    else
        log_success "Updated: ${tools[*]}"
    fi
}

cmd_logs() {
    local show_all=false
    local verbose=false
    local clear=false
    local last_n=10
    local filter_tool=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--all) show_all=true; shift ;;
            -v|--verbose) verbose=true; shift ;;
            -n|--last)
                shift
                if [[ -n "$1" && "$1" =~ ^[0-9]+$ ]]; then
                    last_n="$1"
                    shift
                else
                    log_error "--last requires a number"
                    return 1
                fi
                ;;
            --clear) clear=true; shift ;;
            -h|--help) show_logs_help; return 0 ;;
            -*) log_error "Unknown option: $1"; show_logs_help; return 1 ;;
            *) filter_tool="$1"; shift ;;
        esac
    done
    
    # Handle clear
    if [[ "$clear" == true ]]; then
        local count
        count=$(error_count)
        if [[ "$count" -gt 0 ]]; then
            clear_error_log
            log_success "Cleared $count error(s)"
        else
            log_info "No errors to clear"
        fi
        return 0
    fi
    
    # Check if log exists
    if [[ ! -f "$ERROR_LOG" ]] || [[ ! -s "$ERROR_LOG" ]]; then
        log_success "No errors recorded"
        return 0
    fi
    
    # Filter by tool if specified
    # Match tool name in the tool field (which may be "tool" or "tool/script")
    local log_content
    if [[ -n "$filter_tool" ]]; then
        log_content=$(grep -E "\|${filter_tool}(/|\|)" "$ERROR_LOG" || true)
        if [[ -z "$log_content" ]]; then
            log_success "No errors for '$filter_tool'"
            return 0
        fi
    else
        log_content=$(cat "$ERROR_LOG")
    fi
    
    # Get total count and apply limit
    local total_count
    total_count=$(echo "$log_content" | wc -l | tr -d ' ')
    
    if [[ "$show_all" != true ]]; then
        log_content=$(echo "$log_content" | tail -n "$last_n")
    fi
    
    # Print header
    if [[ -n "$filter_tool" ]]; then
        echo "Errors for '$filter_tool' ($total_count total)"
    else
        echo "Recent Errors ($total_count total)"
    fi
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    
    if [[ "$verbose" == true ]]; then
        # Verbose view: show full error details
        echo "$log_content" | while IFS='|' read -r ts cmd tool code short full; do
            local date_part="${ts:0:19}"
            date_part="${date_part/T/ }"
            echo "[$date_part] $cmd ${tool:+$tool }(exit $code)"
            echo "────────────────────────────────────────────────────────────"
            # Unescape the full message
            echo -e "${full//\\n/$'\n'}" | sed 's/\\|/|/g'
            echo ""
        done
    else
        # Summary view: one line per error
        printf "%-16s  %-8s  %-12s  %s\n" "Timestamp" "Command" "Tool" "Message"
        printf "%-16s  %-8s  %-12s  %s\n" "────────────────" "────────" "────────────" "────────────────────────────────"
        echo "$log_content" | while IFS='|' read -r ts cmd tool _code short _full; do
            local date_part="${ts:0:16}"
            date_part="${date_part/T/ }"
            printf "%-16s  %-8s  %-12s  %s\n" "$date_part" "$cmd" "${tool:--}" "$short"
        done
    fi
    
    echo ""
    if [[ "$verbose" != true ]]; then
        echo "Run 'dot logs -v' for full details"
    fi
    echo "Run 'dot logs --clear' to clear"
}


# Run install for a single tool. If it's already installed (and not forced),
# only configure() runs.
# Usage: install_tool <tool> [force]
install_tool() {
    local tool="$1" force="${2:-false}"
    local script
    script="$(dotfiles_dir)/$tool/install"

    if [[ "$force" != "true" ]] && [[ "$(tool_check "$tool" check_installed no)" == "yes" ]]; then
        log_info "$tool already installed, configuring only..."
        run_logged "install" "$tool" tool_run "$tool" eval 'declare -F configure >/dev/null && configure || true'
    else
        if [[ "$force" == "true" ]]; then
            log_info "Force reinstalling $tool..."
        else
            log_info "Installing $tool..."
        fi
        run_logged "install" "$tool" bash "$script"
    fi
}

cmd_install() {
    local force=false tools=() tool

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force) force=true; shift ;;
            -h|--help) show_install_help; return 0 ;;
            -*) log_error "Unknown option: $1"; show_install_help; return 1 ;;
            *) tools+=("$1"); shift ;;
        esac
    done

    if [[ ${#tools[@]} -eq 0 ]]; then
        clear_error_log
        log_info "Running main install script..."
        "$(dotfiles_dir)/install"
        return $?
    fi

    local failed_tools=() unknown_tools=()
    for tool in "${tools[@]}"; do
        if [[ -f "$(dotfiles_dir)/$tool/install" ]]; then
            install_tool "$tool" "$force" || failed_tools+=("$tool")
        else
            unknown_tools+=("$tool")
        fi
    done

    if [[ ${#unknown_tools[@]} -gt 0 ]]; then
        echo ""
        log_error "Unknown tool(s): ${unknown_tools[*]}"
        echo ""
        echo "Available tools:"
        get_available_tools | sed 's/^/  - /'
        echo ""
    fi

    if [[ ${#failed_tools[@]} -gt 0 ]]; then
        log_warn "Failed to install: ${failed_tools[*]}"
    fi

    if [[ ${#unknown_tools[@]} -gt 0 ]] || [[ ${#failed_tools[@]} -gt 0 ]]; then
        return 1
    fi

    log_success "Done!"
}

show_install_help() {
    cat <<EOF
dot install - Install tools and configurations

Usage:
  dot install                       Run full install script
  dot install <tool> [tool...]      Install specific tool(s)
  dot install <tool> -f|--force     Force reinstall even if already installed
  dot install -h|--help             Show this help

Options:
  -f, --force     Force full reinstall (skip "already installed" check)

Behavior:
  - If a tool is already installed, only configure() is run
  - Use -f/--force to run the full install() + configure()
  - Running 'dot install' without arguments clears the error log first

Available tools:
$(get_available_tools | sed 's/^/  /')
EOF
}

show_status_help() {
    cat <<EOF
dot status - Show installation status of tools

Usage:
  dot status              Show status of all tools
  dot status <tool>       Show detailed status for a specific tool
  dot status -h|--help    Show this help

Shows a table of all tools with their installation and configuration status:
  - Installed: Whether the tool binary/command exists
  - Configured: Whether the tool's config files are symlinked

Status indicators:
  ${GREEN}[OK]${NC}  Installed/Configured
  ${RED}[NO]${NC}  Not installed/Not configured  
  ${YELLOW}[??]${NC}  No health check defined
  ${DIM}[--]${NC}  Not applicable (tool has no config)

When a tool name is provided, shows detailed information including:
  - Installation and configuration status
  - Version number (when available)
  - Recent error logs for that tool

Also displays any recent errors from the log.

Examples:
  dot status              # Show all tools
  dot status nvim         # Show detailed nvim status
  dot status jj           # Show detailed jj status
EOF
}

show_edit_help() {
    cat <<EOF
dot edit - Open dotfiles in editor

Usage:
  dot edit [-h|--help]

Opens the dotfiles directory in your preferred editor.
Uses \$EDITOR, or falls back to nvim/vim.
EOF
}

show_pull_help() {
    cat <<EOF
dot pull - Pull latest changes and apply them

Usage:
  dot pull [--apply] [-h|--help]

Pulls the latest changes from the remote repository.
By default, it then runs apply() for each tool to reload configurations.

On Omarchy, apply() is skipped by default to preserve Omarchy defaults.
Use --apply to force apply() after pulling.

Clears the error log before pulling.
EOF
}

show_update_help() {
    cat <<EOF
dot update - Update installed tools

Usage:
  dot update [tool...] [-h|--help]

Without tools, updates every installed tool with an update() function.
On macOS, also runs 'brew update && brew upgrade'.
With tool names, updates only those tools; Homebrew is skipped.

Tools with update functions:
$(for tool in $(get_available_tools); do tool_has "$tool" update && echo "  $tool"; done)
EOF
}

show_logs_help() {
    cat <<EOF
dot logs - View installation and operation logs

Usage:
  dot logs                    Show recent errors (last 10)
  dot logs -a, --all          Show all logged errors
  dot logs -n, --last N       Show last N errors (default: 10)
  dot logs <tool>             Show errors for a specific tool
  dot logs --clear            Clear the error log
  dot logs -v, --verbose      Show full error details (not truncated)
  dot logs -h, --help         Show this help

Examples:
  dot logs                    # Recent errors, truncated
  dot logs helix              # Errors for helix only
  dot logs -v                 # Recent errors with full details
  dot logs --all -v           # Everything, full details
  dot logs --clear            # Clear log after reviewing

Errors are recorded during install, pull, and update operations.
The log is automatically cleared before 'dot install' (full) or 'dot pull'.
EOF
}

show_help() {
    cat <<EOF
dotfiles - CLI for managing dotfiles

Usage:
  dotfiles [options] <command> [args]

Commands:
  status            Show installation status of all tools
  status <tool>     Show detailed status for a specific tool
  pull              Pull latest changes and apply them
  edit              Open dotfiles in editor
  install           Run main install script
  install <tools>   Install specific tool(s), e.g. 'dotfiles install jj node'
  update [tools]    Update all tools or specific tool(s)
  logs              View installation and operation error logs
  help              Show this help message

Options:
  -v, --verbose     Show verbose output (e.g., skipped tools)
  -h, --help        Show help for a command

Environment:
  DOTFILES_DIR    Override dotfiles directory location
  EDITOR          Editor to use for 'edit' command
EOF
}

# Parse global flags
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        *)
            break
            ;;
    esac
done

# Export VERBOSE for subshells
export VERBOSE

# Main dispatch
case "${1:-}" in
    status)
        shift
        cmd_status "$@"
        ;;
    pull)
        shift
        cmd_pull "$@"
        ;;
    edit)
        shift
        cmd_edit "$@"
        ;;
    install)
        shift
        cmd_install "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'dotfiles help' for usage."
        exit 1
        ;;
esac
