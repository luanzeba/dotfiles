#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_BIN="$HOME/.local/bin"

install() {
    # Scripts are part of dotfiles, nothing to install
    :
}

check_installed() {
    # Scripts are part of dotfiles repo, always "installed"
    return 0
}

check_configured() {
    # Check if dotfiles scripts are accessible in ~/.local/bin
    [[ -x "$LOCAL_BIN/dotfiles" && -x "$LOCAL_BIN/jwt-decode" ]]
}

build_jwt_decode() {
    local target_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/jwt-decode"
    export PATH="$HOME/.nix-profile/bin:$PATH"

    CARGO_TARGET_DIR="$target_dir" cargo build --quiet --release --locked \
        --manifest-path "$SCRIPT_DIR/jwt-decode/Cargo.toml"
    rm -f "$LOCAL_BIN/jwt-decode"
    cp "$target_dir/release/jwt-decode" "$LOCAL_BIN/jwt-decode"
    chmod 755 "$LOCAL_BIN/jwt-decode"
}

configure() {
    # Create dot -> dotfiles alias in the repo itself
    if [[ ! -e "$SCRIPT_DIR/dot" ]]; then
        ln -s dotfiles "$SCRIPT_DIR/dot"
    fi

    # Ensure ~/.local/bin exists
    mkdir -p "$LOCAL_BIN"

    # Remove links to scripts that no longer exist in dotfiles.
    for link in "$LOCAL_BIN"/*; do
        [[ -L "$link" ]] || continue
        local target
        target=$(readlink "$link")
        if [[ "$target" == "$SCRIPT_DIR/"* && ! -e "$target" ]]; then
            rm -f "$link"
        fi
    done

    # The retired todo installer linked a binary from its separate source repo.
    [[ -L "$LOCAL_BIN/todo" ]] && rm -f "$LOCAL_BIN/todo"

    # Symlink each script individually to ~/.local/bin
    for script in "$SCRIPT_DIR"/*; do
        [[ -f "$script" || -L "$script" ]] || continue
        local name
        name=$(basename "$script")
        # Skip the installer and native source files.
        [[ "$name" == "install" || "$name" == *.swift ]] && continue
        ln -sf "$script" "$LOCAL_BIN/$name"
    done

    build_jwt_decode
}

apply() {
    # TODO: Remove this migration block after 2025-03-01 (all machines should be migrated by then)
    # Migration: Remove old ~/bin symlink if it points to dotfiles/bin
    if [[ -L "$HOME/bin" ]]; then
        local target
        target=$(readlink "$HOME/bin")
        if [[ "$target" == *"dotfiles/bin"* ]]; then
            echo "Migrating from ~/bin to ~/.local/bin..."
            rm "$HOME/bin"
        fi
    fi

    # Ensure all scripts are symlinked to ~/.local/bin
    configure
}

# Main (only run when executed directly, not when sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
