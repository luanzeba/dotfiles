#!/bin/bash
set -e

# 1Password CLI (op). Sign-in is machine-local: `op signin`.

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/../lib/nix.sh"

nix_package_tool 1password op

configure() {
    echo "1Password CLI installed. Sign in with: op signin"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    install
    configure
fi
